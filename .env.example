# Copiá este archivo como ".env" EN EL SERVIDOR (no se sube al repo).
# docker-compose lo lee automáticamente.

# Secreto que usa la tarea de Windows para subir el Excel (POST /api/upload).
UPLOAD_SECRET=pon-aca-un-secreto-largo-y-aleatorio

# --- Login por perfiles ---
# Cuenta de administrador (la que crea/borra perfiles y resetea claves).
ADMIN_USER=admin
ADMIN_PASS=pon-aca-la-clave-del-admin

# (Opcional) Clave para firmar las sesiones. Si la dejás vacía se genera sola
# y se guarda en /data. Ponela solo si querés fijarla vos.
# SESSION_SECRET=

# --- Notificaciones por email (opcional) ---
# Si SMTP_HOST está vacío, no se envían mails (los cambios igual se guardan).
# Para Microsoft 365: smtp.office365.com puerto 587.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=notificaciones.camaras@pilar.gov.ar
# SMTP_PASS=la-app-password-de-la-cuenta
# SMTP_FROM=notificaciones.camaras@pilar.gov.ar
# NOTIFY_TO=yannicknow12@gmail.com,otra@pilar.gov.ar
# DASHBOARD_URL=https://camaraseg.pilar.gov.ar
