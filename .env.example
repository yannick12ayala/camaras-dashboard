# Copiá este archivo como referencia. NO subas el .env real al repo.
# En Vercel se configura en: Project → Settings → Environment Variables.

# Secreto compartido entre Power Automate y el endpoint /api/upload.
# Generá uno largo y aleatorio. Debe coincidir exactamente con el header
# x-upload-secret que manda Power Automate.
UPLOAD_SECRET=pon-aca-un-secreto-largo-y-aleatorio

# BLOB_READ_WRITE_TOKEN lo crea Vercel automáticamente al conectar un
# Blob Store al proyecto. No hace falta ponerlo a mano.
