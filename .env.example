# Copiá este archivo como referencia. NO subas el .env real al repo.
# En Vercel se configuran en: Project → Settings → Environment Variables.

# Secreto compartido entre Power Automate y el endpoint /api/upload.
UPLOAD_SECRET=pon-aca-un-secreto-largo-y-aleatorio

# Token de GitHub con permiso de Gist (scope "gist"). Vive solo en el servidor.
GITHUB_TOKEN=ghp_tu_token_con_scope_gist

# ID del Gist donde se guarda el Excel (el hash de la URL del gist).
GIST_ID=el_id_del_gist
