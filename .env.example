# Copiá este archivo como ".env" EN EL SERVIDOR (no se sube al repo).
# docker-compose lo lee automáticamente.

# Secreto que usa la tarea de Windows para subir el Excel (POST /api/upload).
UPLOAD_SECRET=pon-aca-un-secreto-largo-y-aleatorio

# --- Login por perfiles ---
# Cuenta de administrador (la que crea/borra perfiles y resetea claves).
ADMIN_USER=admin
ADMIN_PASS=pon-aca-la-clave-del-admin

# (Opcional) Clave para firmar las sesiones. Si la dejás vacía se genera sola
# y se guarda en /data. Ponela solo si querés fijarla vos.
# SESSION_SECRET=
